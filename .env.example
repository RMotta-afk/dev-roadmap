# Shared
DATABASE_URL=postgresql+asyncpg://cv_analyzer:localdev@localhost:5432/cv_analyzer
AUTHJWT_SECRET=local-dev-secret-change-in-production

# Backend (apps/api) — local process uses localhost ports from Docker
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
CORS_ALLOW=http://localhost:8501
# Relative paths resolve to monorepo root (not apps/api cwd)
BASE_ROADMAP_PATH=docs/archives

# UI (apps/ui) — points at local API
API_BASE_URL=http://localhost:8000
