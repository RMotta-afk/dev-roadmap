# Web (Next.js) environment variables — template.
# Copy this file to `.env.local` and fill in real values. The web app is
# deployed separately from the API, so it owns its own env and does not read
# the monorepo root .env. Only the variables the frontend actually consumes
# are listed here.

# NextAuth v5 — secret used to encrypt/sign the session JWT.
# Generate a strong value for production, e.g. `openssl rand -base64 32`.
AUTH_SECRET=change-me-in-production

# Public URL of the frontend, used by NextAuth for auth callbacks/redirects.
NEXTAUTH_URL=http://localhost:3000

# Public API base URL the browser uses to reach the FastAPI backend.
# Exposed to the client (NEXT_PUBLIC_ prefix); set to the deployed API URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-side URL for the FastAPI backend. Used by Next.js API proxy routes.
API_BASE_URL=http://localhost:8000

# Secret used to mint the short-lived JWT the Next.js API routes send to the
# FastAPI backend. MUST match the backend's `authjwt_secret` (or the env var
# the backend uses for it, e.g. AUTHJS_JWT_SECRET).
AUTH_BACKEND_SECRET=change-me-in-production

# Postgres connection for the Drizzle (postgres-js) client used by auth.
# Use the plain `postgresql://` scheme (the JS driver does not use the
# Python `+asyncpg` dialect).
DATABASE_URL=postgresql://cv_analyzer:localdev@localhost:5432/cv_analyzer
